+@router.get("/visits/{diagnosis_id}/image")
+async def visit_image(
+    diagnosis_id: int,
+    request: Request,
+    session: AsyncSession = Depends(get_session),
+    settings: Settings = Depends(get_settings),
+):
+    redirect = require_authentication(request)
+    if redirect:
+        return redirect
+
+    diagnosis = await session.get(Diagnosis, diagnosis_id)
+    if not diagnosis or not diagnosis.telegram_file_id:
+        raise HTTPException(status_code=404, detail="Image not found")
+
+    import httpx
+    async with httpx.AsyncClient(timeout=10) as client:
+        file_info = await client.get(
+            f"https://api.telegram.org/bot{settings.bot_token}/getFile",
+            params={"file_id": diagnosis.telegram_file_id},
+        )
+        data = file_info.json()
+        if not data.get("ok"):
+            raise HTTPException(status_code=404, detail="Image unavailable")
+        file_path = data["result"]["file_path"]
+        image = await client.get(
+            f"https://api.telegram.org/file/bot{settings.bot_token}/{file_path}"
+        )
+    return Response(content=image.content, media_type=image.headers.get("content-type", "image/jpeg"))
+
+
