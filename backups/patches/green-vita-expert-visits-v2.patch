+        <h1 class="text-2xl font-bold">🩺 درخواست ویزیت #{{ diagnosis.id }}</h1>
+        <p class="text-sm text-gray-500 mt-1">پرونده و مدیریت درخواست</p>
+    </div>
+    <a href="/visits" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm">بازگشت به درخواست‌ها</a>
+</div>
+
+<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
+<div class="lg:col-span-2 space-y-6">
+    <div class="bg-white rounded-xl shadow p-5">
+        <h2 class="font-bold text-lg mb-4">اطلاعات کاربر</h2>
+        <div class="grid grid-cols-2 gap-4 text-sm">
