+    {% if diagnosis.expert_visit_scheduled_at %}
+    <p class="mt-4"><span class="text-gray-500">زمان ویزیت:</span> {{ diagnosis.expert_visit_scheduled_at.strftime('%Y-%m-%d %H:%M') }}</p>
+    {% endif %}
+</div>
+</div>
+</div>
+{% endblock %}
