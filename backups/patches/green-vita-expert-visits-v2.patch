+    <button class="w-full bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg px-4 py-3 font-semibold">ذخیره تغییرات</button>
+</form>
+
+<div class="bg-white rounded-xl shadow p-5 text-sm">
+    <h2 class="font-bold mb-3">وضعیت فعلی</h2>
+    <span class="px-3 py-2 rounded-full {{ status_classes.get(diagnosis.expert_visit_status, 'bg-gray-100 text-gray-700') }}">
+        {{ status_labels.get(diagnosis.expert_visit_status, diagnosis.expert_visit_status) }}
