+    <input type="datetime-local" name="scheduled_at"
+           value="{{ diagnosis.expert_visit_scheduled_at.strftime('%Y-%m-%dT%H:%M') if diagnosis.expert_visit_scheduled_at else '' }}"
+           class="w-full border rounded-lg px-3 py-2 mb-4">
+
+    <label class="block text-sm font-semibold mb-2">یادداشت داخلی</label>
+    <textarea name="admin_note" rows="6" class="w-full border rounded-lg px-3 py-2 mb-4" placeholder="این یادداشت فقط برای مدیریت Green Vita است...">{{ diagnosis.expert_visit_admin_note or '' }}</textarea>
