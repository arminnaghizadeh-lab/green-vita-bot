+            <div><span class="text-gray-500">شماره تماس:</span> {{ user.phone_number or '—' }}</div>
+        </div>
+    </div>
+
+    <div class="bg-white rounded-xl shadow p-5">
+        <h2 class="font-bold text-lg mb-4">اطلاعات گیاه و تشخیص</h2>
+        <div class="grid grid-cols-2 gap-4 text-sm">
+            <div><span class="text-gray-500">گیاه:</span> {{ plant.name if plant else (diagnosis.plant_name_input or '—') }}</div>
+            <div><span class="text-gray-500">بیماری/مشکل:</span> {{ diagnosis.disease_name }}</div>
+            <div><span class="text-gray-500">شدت:</span> {{ diagnosis.severity.value if diagnosis.severity else '—' }}</div>
+            <div><span class="text-gray-500">اطمینان AI:</span> {{ diagnosis.confidence }}%</div>
+        </div>
+        {% if diagnosis.user_notes %}
+        <div class="mt-4 p-4 bg-gray-50 rounded-lg"><strong>توضیحات کاربر:</strong><br>{{ diagnosis.user_notes }}</div>
+        {% endif %}
+        {% if diagnosis.symptoms %}
+        <div class="mt-4 p-4 bg-amber-50 rounded-lg"><strong>علائم:</strong><br>{{ diagnosis.symptoms }}</div>
+        {% endif %}
+        {% if diagnosis.cause %}
+        <div class="mt-4 p-4 bg-blue-50 rounded-lg"><strong>علت احتمالی:</strong><br>{{ diagnosis.cause }}</div>
+        {% endif %}
+        {% if diagnosis.treatment %}
+        <div class="mt-4 p-4 bg-emerald-50 rounded-lg"><strong>درمان پیشنهادی:</strong><br>{{ diagnosis.treatment }}</div>
+        {% endif %}
+    </div>
+</div>
+
+<div class="space-y-6">
+<form method="post" action="/visits/{{ diagnosis.id }}/update" class="bg-white rounded-xl shadow p-5">
