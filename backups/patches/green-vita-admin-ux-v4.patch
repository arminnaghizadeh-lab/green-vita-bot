+@router.get("/visits/{diagnosis_id}/image")
+async def visit_image(
+    diagnosis_id: int,
+    session: AsyncSession = Depends(get_session),
+    settings: Settings = Depends(get_settings),
+):
+    diagnosis = await session.get(Diagnosis, diagnosis_id)
+    if not diagnosis or not diagnosis.telegram_file_id:
+        raise HTTPException(status_code=404, detail="Image not found")
+
+    import httpx
+    async with httpx.AsyncClient() as client:
+        result = await client.get(
+            f"https://api.telegram.org/bot{settings.bot_token}/getFile",
+            params={"file_id": diagnosis.telegram_file_id},
+        )
+        data = result.json()
+        if not data.get("ok"):
+            raise HTTPException(status_code=404, detail="Telegram file unavailable")
+        image = await client.get(
+            f"https://api.telegram.org/file/bot{settings.bot_token}/{data['result']['file_path']}"
+        )
+    return Response(content=image.content, media_type="image/jpeg")
+
