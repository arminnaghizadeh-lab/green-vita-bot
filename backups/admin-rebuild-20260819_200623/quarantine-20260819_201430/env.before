# Green Vita AI Plant Clinic - Environment Variables
# این فایل را کپی کن به .env و مقادیر واقعی را جایگزین کن
# cp .env.example .env
# ============================================================

# ---------- App ----------
APP_ENV=production           # development | staging | production
APP_NAME="Green Vita AI Plant Clinic"
DEBUG=false
SECRET_KEY=97daa0035a5a18f67ae1334948d5d69876ea312b082b78636f0900e6ba62c443
TIMEZONE=Asia/Tehran

# ---------- Telegram Bot ----------
BOT_TOKEN=8731176359:AAF0CqNBQCo-Q_e_5j42OGWsYiCrueggzZM
BOT_ADMIN_IDS=123456789,987654321   # آیدی عددی تلگرام ادمین‌ها، با کاما جدا شود

# ---------- Database ----------
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://greenvita:cc223b40515f73f761ece1ae8e9e061389210eea0dead77e@db:5432/greenvita
# Local dev fallback (SQLite) - اگر DATABASE_URL خالی بماند از این استفاده می‌شود:
# DATABASE_URL=sqlite+aiosqlite:///./greenvita.db

POSTGRES_USER=greenvita
POSTGRES_PASSWORD=cc223b40515f73f761ece1ae8e9e061389210eea0dead77e
POSTGRES_DB=greenvita
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- AI Provider ----------
# یکی را انتخاب کن: claude | gemini | openai
AI_PROVIDER=openai

# فقط کلید مربوط به پروایدر انتخابی لازم است، بقیه را خالی بگذار
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=aa-szXvm4LnBZIWeCuBiNnXmDbGNFgkIJxmN0NliqHHmKUZ140t
OPENAI_MODEL=gpt-5
# اختیاری: فقط اگر از یک gateway سازگار با OpenAI استفاده می‌کنی (مثل AvalAI/GapGPT)
# تا از پشتش به مدل‌های غیر-OpenAI (مثلاً Claude) دسترسی داشته باشی.
# مثال: برای AvalAI با مدل Claude → AI_PROVIDER=openai, OPENAI_MODEL=claude-sonnet-4-6
# خالی بگذار = آدرس رسمی OpenAI.
OPENAI_BASE_URL=https://api.avalai.ir/v1

# ---------- Admin Panel ----------


# ---------- Logging ----------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console
