# ============================================================
# Green Vita AI Plant Clinic - Environment Variables
# این فایل را کپی کن به .env و مقادیر واقعی را جایگزین کن
# cp .env.example .env
# ============================================================

# ---------- App ----------
APP_ENV=development            # development | staging | production
APP_NAME="Green Vita AI Plant Clinic"
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-string
TIMEZONE=Asia/Tehran

# ---------- Telegram Bot ----------
BOT_TOKEN=123456789:AAExampleTokenFromBotFather
BOT_ADMIN_IDS=123456789,987654321   # آیدی عددی تلگرام ادمین‌ها، با کاما جدا شود

# ---------- Database ----------
# Production (PostgreSQL):
DATABASE_URL=postgresql+asyncpg://greenvita:greenvita@db:5432/greenvita
# Local dev fallback (SQLite) - اگر DATABASE_URL خالی بماند از این استفاده می‌شود:
# DATABASE_URL=sqlite+aiosqlite:///./greenvita.db

POSTGRES_USER=greenvita
POSTGRES_PASSWORD=greenvita
POSTGRES_DB=greenvita
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- AI Provider ----------
# یکی را انتخاب کن: claude | gemini | openai
AI_PROVIDER=claude

# فقط کلید مربوط به پروایدر انتخابی لازم است، بقیه را خالی بگذار
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# اختیاری: فقط اگر از یک gateway سازگار با OpenAI استفاده می‌کنی (مثل AvalAI/GapGPT)
# تا از پشتش به مدل‌های غیر-OpenAI (مثلاً Claude) دسترسی داشته باشی.
# مثال: برای AvalAI با مدل Claude → AI_PROVIDER=openai, OPENAI_MODEL=claude-sonnet-4-6
# خالی بگذار = آدرس رسمی OpenAI.
OPENAI_BASE_URL=

# ---------- Admin Panel ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-to-another-random-string
ADMIN_PORT=8000

# ---------- Logging ----------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console
