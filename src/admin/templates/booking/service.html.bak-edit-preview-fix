<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ service.title }} | گرین ویتا</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f6f8f5;font-family:Arial,sans-serif;color:#18251c}
.wrap{max-width:760px;margin:auto;padding:24px 16px}
.card{background:#fff;border-radius:22px;padding:24px;box-shadow:0 8px 30px #0000000d}
.back{display:inline-block;margin-bottom:20px;color:#28743b;text-decoration:none}
h1{margin:0 0 10px;font-size:25px}
.desc{color:#66736a;line-height:1.9}
.price{font-size:20px;font-weight:bold;color:#28743b;margin:18px 0}
h2{font-size:19px;margin-top:30px}
.dates{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.date{border:1px solid #dce5dd;border-radius:14px;background:#fff;padding:12px 5px;text-align:center;cursor:pointer}
.date:hover,.date.active{background:#28743b;color:#fff;border-color:#28743b}
.date strong{display:block;font-size:15px}
.date small{display:block;margin-top:5px}
@media(max-width:600px){
  .dates{grid-template-columns:repeat(2,1fr)}
  .times{grid-template-columns:repeat(2,1fr)}

  #previewSection .summary-row{
    grid-template-columns:105px minmax(0,1fr);
    gap:10px;
    padding:9px 0;
  }

  #previewSection .summary-row span{
    font-size:12px;
  }

  #previewSection .summary-row strong{
    font-size:13px;
  }
}

.times{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:12px;
}

.time{
  border:1px solid #dce5dd;
  border-radius:14px;
  background:#fff;
  padding:12px 8px;
  text-align:center;
  cursor:pointer;
  font-family:inherit;
  font-size:15px;
  font-weight:bold;
}

.time.active{
  background:#28743b;
  color:#fff;
  border-color:#28743b;
}

.hidden{
  display:none !important;
}

.form-section{
  margin-top:28px;
  padding-top:22px;
  border-top:1px solid #edf1ed;
}

.form-grid{
  display:grid;
  gap:13px;
}

.field label{
  display:block;
  margin-bottom:7px;
  font-size:13px;
  color:#506057;
}

.field input,
.field textarea{
  width:100%;
  border:1px solid #d9e2da;
  border-radius:13px;
  padding:12px 13px;
  font:inherit;
  outline:none;
  background:#fff;
}

.field input:focus,
.field textarea:focus{
  border-color:#28743b;
}

.field textarea{
  min-height:90px;
  resize:vertical;
}

.summary{
  margin-top:20px;
  background:#f6faf6;
  border:1px solid #e1ebe2;
  border-radius:17px;
  padding:16px;
}

.summary-row{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:7px 0;
}

.summary-row.total{
  border-top:1px solid #dce5dd;
  margin-top:7px;
  padding-top:13px;
  font-weight:bold;
  color:#28743b;
}

#previewSection .summary-row{
  display:grid;
  grid-template-columns:120px minmax(0,1fr);
  align-items:start;
  gap:14px;
  min-height:42px;
}

#previewSection .summary-row span{
  font-size:13px;
  color:#607067;
}

#previewSection .summary-row strong{
  text-align:left;
  line-height:1.8;
  overflow-wrap:anywhere;
}

.submit{
  width:100%;
  margin-top:16px;
  border:0;
  border-radius:15px;
  padding:14px;
  background:#28743b;
  color:#fff;
  font-family:inherit;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}

.submit:disabled{
  opacity:.55;
  cursor:not-allowed;
}

.message{
  display:none;
  margin-top:13px;
  padding:12px;
  border-radius:13px;
  background:#fff1f1;
  color:#9b3030;
  line-height:1.8;
}

.success{
  margin-top:22px;
  padding:20px;
  border-radius:18px;
  background:#edf8ef;
  border:1px solid #d8ecd9;
  text-align:center;
}

.tracking{
  display:inline-block;
  margin:10px 0;
  padding:9px 15px;
  background:#fff;
  border-radius:11px;
  font-size:20px;
  font-weight:bold;
  direction:ltr;
  letter-spacing:1px;
}
</style>
</head>
<body>
<main class="wrap">
<a class="back" href="/booking/">← بازگشت به خدمات</a>

<section class="card">
<h1>{{ service.title }}</h1>

{% if service.description %}
<p class="desc">{{ service.description }}</p>
{% endif %}

<div class="price">
{% if service.price %}
{{ "{:,}".format(service.price|int) }} تومان
{% else %}
رایگان
{% endif %}
</div>

<h2>انتخاب تاریخ</h2>
<div id="dates" class="dates">
<div class="date">در حال بارگذاری...</div>
</div>

<div id="timesSection" class="hidden" style="margin-top:28px">
  <h2>۲. انتخاب ساعت شروع</h2>
  <div id="times" class="times"></div>
</div>

<div id="durationSection" class="form-section hidden">
  <h2>۳. مدت رزرو</h2>
  <div id="durations" class="times"></div>
</div>

<div id="customerSection" class="form-section hidden">

  <h2>۴. اطلاعات شما</h2>

  <div class="form-grid">

    <div class="field">
      <label for="customerName">نام و نام خانوادگی *</label>
      <input
        id="customerName"
        type="text"
        autocomplete="name"
        placeholder="نام و نام خانوادگی">
    </div>

    <div class="field">
      <label for="customerPhone">شماره تماس *</label>
      <input
        id="customerPhone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        placeholder="مثلاً 09121234567">
    </div>

    <div class="field">
      <label for="customerEmail">ایمیل</label>
      <input
        id="customerEmail"
        type="email"
        autocomplete="email"
        placeholder="example@email.com">
    </div>

    <div class="field">
      <label for="plantName">نام گیاه</label>
      <input
        id="plantName"
        type="text"
        placeholder="مثلاً فیکوس">
    </div>

    <div class="field">
      <label for="plantDescription">شرح مشکل گیاه</label>
      <textarea
        id="plantDescription"
        placeholder="علائم و توضیحات مشکل گیاه..."></textarea>
    </div>

    <div class="field">
      <label for="notes">توضیحات تکمیلی</label>
      <textarea
        id="notes"
        placeholder="هر توضیح یا درخواست دیگری..."></textarea>
    </div>

  </div>

  <div id="message" class="message"></div>

  <button id="submitBtn" class="submit" type="button">
    پیش‌نمایش رزرو
  </button>

  <div id="previewSection" class="success hidden">
    <h2>پیش‌نمایش رزرو</h2>

    <div class="summary">
      <div class="summary-row">
        <span>خدمت</span>
        <strong id="previewService">—</strong>
      </div>

      <div class="summary-row">
        <span>تاریخ</span>
        <strong id="previewDate">—</strong>
      </div>

      <div class="summary-row">
        <span>بازه زمانی</span>
        <strong id="previewTime">—</strong>
      </div>

      <div class="summary-row">
        <span>مدت</span>
        <strong id="previewDuration">—</strong>
      </div>

      <div class="summary-row">
        <span>مشتری</span>
        <strong id="previewCustomer">—</strong>
      </div>

      <div class="summary-row">
        <span>شماره تماس</span>
        <strong id="previewPhone">—</strong>
      </div>

      <div class="summary-row">
        <span>گیاه</span>
        <strong id="previewPlant">—</strong>
      </div>

      <div class="summary-row">
        <span>شرح مشکل</span>
        <strong id="previewProblem">—</strong>
      </div>

      <div class="summary-row">
        <span>توضیحات</span>
        <strong id="previewNotes">—</strong>
      </div>

      <div class="summary-row total">
        <span>مبلغ نهایی</span>
        <strong id="previewAmount">—</strong>
      </div>
    </div>

    <button id="confirmBtn" class="submit" type="button">
      تأیید و ثبت نهایی
    </button>
  </div>

</div>

<div id="success" class="success hidden">
  <h2>رزرو شما با موفقیت ثبت شد 🌱</h2>
  <p>وضعیت رزرو: در انتظار تأیید</p>
  <div>کد پیگیری</div>
  <div id="trackingCode" class="tracking"></div>
  <p>این کد را برای پیگیری رزرو نگه دارید.</p>
</div>

</section>
</main>

<script>
const serviceId = {{ service.id }};
const serviceTitle = {{ service.title | tojson }};
const basePrice = {{ service.price|int }};

const dates = document.getElementById("dates");
const timesSection = document.getElementById("timesSection");
const times = document.getElementById("times");

const durationSection = document.getElementById("durationSection");
const durations = document.getElementById("durations");

const customerSection = document.getElementById("customerSection");
const submitBtn = document.getElementById("submitBtn");

const message = document.getElementById("message");
const previewSection = document.getElementById("previewSection");
const confirmBtn = document.getElementById("confirmBtn");
const success = document.getElementById("success");

let selectedDate = null;
let selectedSlot = null;
let selectedDuration = null;
let selectedEndTime = null;
let selectedAmount = 0;

function englishDigits(value){
  return String(value)
    .replace(/[۰-۹]/g, x => "۰۱۲۳۴۵۶۷۸۹".indexOf(x))
    .replace(/[٠-٩]/g, x => "٠١٢٣٤٥٦٧٨٩".indexOf(x));
}

function jalaliParts(date){
  const parts = new Intl.DateTimeFormat(
    "en-US-u-ca-persian",
    {
      year:"numeric",
      month:"2-digit",
      day:"2-digit"
    }
  ).formatToParts(date);

  return {
    year: parts.find(x => x.type === "year").value,
    month: parts.find(x => x.type === "month").value,
    day: parts.find(x => x.type === "day").value
  };
}

function showError(text){
  message.textContent = text;
  message.style.display = "block";
}

function clearError(){
  message.textContent = "";
  message.style.display = "none";
}

function formatPrice(value){
  return Number(value).toLocaleString("fa-IR") + " تومان";
}

function resetAfterDateChange(){
  selectedSlot = null;
  selectedDuration = null;
  selectedEndTime = null;
  selectedAmount = 0;

  durationSection.classList.add("hidden");
  customerSection.classList.add("hidden");
  previewSection.classList.add("hidden");

  durations.innerHTML = "";
}

function resetAfterTimeChange(){
  selectedDuration = null;
  selectedEndTime = null;
  selectedAmount = 0;

  customerSection.classList.add("hidden");
  previewSection.classList.add("hidden");

  durations.innerHTML = "";
}

function loadDates(){
  dates.innerHTML = "";

  const weekday = new Intl.DateTimeFormat(
    "fa-IR-u-ca-persian",
    {weekday:"long"}
  );

  for(let i = 0; i < 7; i++){
    const dt = new Date();

    dt.setHours(12,0,0,0);
    dt.setDate(dt.getDate() + i);

    const p = jalaliParts(dt);
    const value = `${p.year}-${p.month}-${p.day}`;

    const button = document.createElement("button");

    button.type = "button";
    button.className = "date";

    button.innerHTML =
      `<strong>${weekday.format(dt)}</strong>
       <small>${value}</small>`;

    button.addEventListener(
      "click",
      () => selectDate(button, value)
    );

    dates.appendChild(button);
  }

  const first = dates.querySelector(".date");

  if(first){
    first.click();
  }
}

async function selectDate(button, date){
  clearError();

  document.querySelectorAll(".date")
    .forEach(x => x.classList.remove("active"));

  button.classList.add("active");

  selectedDate = date;

  resetAfterDateChange();

  timesSection.classList.remove("hidden");

  times.innerHTML =
    '<div class="loading">در حال دریافت ساعت‌های آزاد...</div>';

  try{
    const response = await fetch(
      `/booking/api/slots/${serviceId}/${date}`,
      {
        headers:{
          "Accept":"application/json"
        }
      }
    );

    const data = await response.json();

    if(!response.ok || data.error){
      times.innerHTML =
        `<div class="empty">${data.error || "خطا در دریافت زمان‌ها."}</div>`;
      return;
    }

    if(!data.slots || !data.slots.length){
      times.innerHTML =
        '<div class="empty">برای این تاریخ بازه قابل رزرو باقی نمانده است.</div>';
      return;
    }

    times.innerHTML = "";

    data.slots.forEach(slot => {
      const button = document.createElement("button");

      button.type = "button";
      button.className = "time";
      button.textContent = slot.time;

      button.addEventListener("click", () => {
        document.querySelectorAll(".time")
          .forEach(x => x.classList.remove("active"));

        button.classList.add("active");

        selectedSlot = slot;

        resetAfterTimeChange();

        const validDurations =
          slot.available_durations || [];

        if(!validDurations.length){
          showError(
            "برای این ساعت مدت رزرو معتبری وجود ندارد."
          );
          return;
        }

        durationSection.classList.remove("hidden");

        validDurations.forEach(option => {
          const durationButton =
            document.createElement("button");

          durationButton.type = "button";
          durationButton.className = "time";

          const hourText =
            option.hours === 1
              ? "۱ ساعت"
              : `${option.hours} ساعت`;

          durationButton.innerHTML =
            `<strong>${hourText}</strong>
             <small>${option.end_time} — ${formatPrice(option.amount)}</small>`;

          durationButton.addEventListener(
            "click",
            () => selectDuration(
              durationButton,
              option
            )
          );

          durations.appendChild(durationButton);
        });

        durationSection.scrollIntoView({
          behavior:"smooth",
          block:"start"
        });
      });

      times.appendChild(button);
    });

  }catch(error){
    times.innerHTML =
      '<div class="empty">ارتباط با سرور برقرار نشد.</div>';
  }
}

function selectDuration(button, option){
  clearError();

  document.querySelectorAll("#durations .time")
    .forEach(x => x.classList.remove("active"));

  button.classList.add("active");

  selectedDuration = option.hours;
  selectedEndTime = option.end_time;
  selectedAmount = option.amount;


  customerSection.classList.remove("hidden");

  previewSection.classList.add("hidden");

  customerSection.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });
}

function getValue(id){
  return document.getElementById(id).value.trim();
}

function updatePreview(){
  const customerName = getValue("customerName");
  const customerPhone = englishDigits(
    getValue("customerPhone")
  );
  const customerEmail = getValue("customerEmail");
  const plantName = getValue("plantName");
  const plantDescription = getValue("plantDescription");
  const notes = getValue("notes");

  if(!selectedSlot || !selectedDuration){
    showError(
      "لطفاً تاریخ، ساعت شروع و مدت رزرو را انتخاب کنید."
    );
    return false;
  }

  if(!customerName){
    showError("نام و نام خانوادگی را وارد کنید.");
    return false;
  }

  if(!customerPhone){
    showError("شماره تماس را وارد کنید.");
    return false;
  }

  document.getElementById("previewService").textContent =
    serviceTitle;

  document.getElementById("previewDate").textContent =
    selectedDate;

  document.getElementById("previewTime").textContent =
    `${selectedSlot.time} تا ${selectedEndTime}`;

  document.getElementById("previewDuration").textContent =
    `${selectedDuration} ساعت — ${selectedSlot.time} تا ${selectedEndTime}`;

  document.getElementById("previewCustomer").textContent =
    customerName;

  document.getElementById("previewPhone").textContent =
    customerPhone;

  document.getElementById("previewPlant").textContent =
    plantName || "—";

  document.getElementById("previewProblem").textContent =
    plantDescription || "—";

  document.getElementById("previewNotes").textContent =
    notes || "—";

  document.getElementById("previewAmount").textContent =
    formatPrice(selectedAmount);

  previewSection.classList.remove("hidden");

  previewSection.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

  return true;
}

submitBtn.addEventListener(
  "click",
  () => {
    clearError();

    submitBtn.disabled = true;
    submitBtn.textContent = "در حال آماده‌سازی پیش‌نمایش...";

    const valid = updatePreview();

    submitBtn.disabled = false;
    submitBtn.textContent = "ویرایش / نمایش پیش‌نمایش";
  }
);

confirmBtn.addEventListener(
  "click",
  async () => {
    clearError();

    if(!selectedSlot || !selectedDuration){
      showError("اطلاعات زمان رزرو کامل نیست.");
      return;
    }

    const customerName = getValue("customerName");
    const customerPhone = englishDigits(
      getValue("customerPhone")
    );

    const customerEmail =
      getValue("customerEmail");

    const plantName =
      getValue("plantName");

    const plantDescription =
      getValue("plantDescription");

    const notes =
      getValue("notes");

    if(!customerName || !customerPhone){
      showError(
        "نام و شماره تماس الزامی هستند."
      );
      return;
    }

    confirmBtn.disabled = true;
    confirmBtn.textContent =
      "در حال ثبت نهایی...";

    const form = new FormData();

    form.append(
      "service_id",
      serviceId
    );

    form.append(
      "slot_id",
      selectedSlot.id
    );

    form.append(
      "duration_hours",
      selectedDuration
    );

    form.append(
      "customer_name",
      customerName
    );

    form.append(
      "customer_phone",
      customerPhone
    );

    form.append(
      "customer_email",
      customerEmail
    );

    form.append(
      "plant_name",
      plantName
    );

    form.append(
      "plant_description",
      plantDescription
    );

    form.append(
      "notes",
      notes
    );

    try{
      const response = await fetch(
        "/booking/api/book",
        {
          method:"POST",
          body:form,
          headers:{
            "Accept":"application/json"
          }
        }
      );

      const data = await response.json();

      if(!response.ok || !data.success){
        showError(
          data.error || "ثبت رزرو انجام نشد."
        );

        confirmBtn.disabled = false;
        confirmBtn.textContent =
          "تأیید و ثبت نهایی";

        return;
      }

      customerSection.classList.add("hidden");
      durationSection.classList.add("hidden");
      timesSection.classList.add("hidden");
      previewSection.classList.add("hidden");

      document.getElementById("trackingCode")
        .textContent = data.tracking_code;

      success.classList.remove("hidden");

      success.scrollIntoView({
        behavior:"smooth",
        block:"start"
      });

    }catch(error){
      showError(
        "ارتباط با سرور برقرار نشد. لطفاً دوباره تلاش کنید."
      );

      confirmBtn.disabled = false;
      confirmBtn.textContent =
        "تأیید و ثبت نهایی";
    }
  }
);

loadDates();
</script>
</body>
</html>
