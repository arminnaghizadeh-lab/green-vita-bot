:root {
    --green: #4f7f4f;
    --green-dark: #355d3b;
    --green-light: #dce9d5;
    --cream: #f6f0df;
    --cream-soft: #fbf8ef;
    --ink: #243128;
    --muted: #718076;
    --white: #ffffff;
    --danger: #b94747;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Tahoma, Arial, sans-serif;
    color: var(--ink);
    background: linear-gradient(135deg, var(--cream-soft), var(--cream));
}

.topbar {
    min-height: 76px;
    background: var(--green-dark);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 28px;
    box-shadow: 0 4px 18px rgba(0,0,0,.08);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand img {
    width: 58px;
    height: 58px;
    object-fit: contain;
    border-radius: 14px;
    background: white;
    padding: 4px;
}

.brand span {
    display: block;
    opacity: .75;
    font-size: 12px;
    margin-top: 4px;
}

.container {
    max-width: 1250px;
    margin: 0 auto;
    padding: 32px 20px 60px;
}

.hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    background: rgba(255,255,255,.75);
    border: 1px solid rgba(79,127,79,.15);
    border-radius: 24px;
    padding: 28px;
    margin-bottom: 24px;
}

.hero h1 {
    margin: 0 0 8px;
}

.hero p {
    color: var(--muted);
    margin: 0;
}

.primary-link,
button {
    border: 0;
    border-radius: 12px;
    padding: 12px 18px;
    background: var(--green);
    color: white;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
}

.logout {
    background: rgba(255,255,255,.16);
}

.stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px;
}

.stat-card {
    background: var(--white);
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 8px 24px rgba(38,57,40,.07);
}

.stat-card span {
    color: var(--muted);
    font-size: 14px;
}

.stat-card strong {
    display: block;
    font-size: 32px;
    color: var(--green-dark);
    margin-top: 14px;
}

.stat-card.highlight {
    background: var(--green-light);
}

.login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
}

.login-card {
    width: min(430px, 100%);
    background: rgba(255,255,255,.92);
    border-radius: 28px;
    padding: 36px;
    box-shadow: 0 20px 60px rgba(42,70,45,.13);
    text-align: center;
}

.login-logo {
    width: 150px;
    height: 150px;
    object-fit: contain;
    border-radius: 24px;
    background: var(--green-dark);
    padding: 12px;
    margin-bottom: 18px;
}

.muted {
    color: var(--muted);
}

.login-card form {
    margin-top: 28px;
    text-align: right;
}

.login-card label {
    display: block;
    margin: 14px 0 7px;
    font-weight: bold;
}

.login-card input {
    width: 100%;
    padding: 13px;
    border: 1px solid #d8dfd5;
    border-radius: 12px;
    font: inherit;
    background: var(--cream-soft);
}

.login-card button {
    width: 100%;
    margin-top: 22px;
}

.alert {
    background: #fff0f0;
    color: var(--danger);
    border-radius: 12px;
    padding: 12px;
    margin-top: 20px;
}

@media (max-width: 700px) {
    .hero {
        flex-direction: column;
        align-items: stretch;
    }

    .topbar {
        padding: 10px 16px;
    }

    .container {
        padding-inline: 12px;
    }
}

/* =========================================================
   Green Vita Calendar UI
   ========================================================= */

.calendar-page {
    max-width: 1450px;
}

.calendar-hero {
    align-items: center;
}

.calendar-kicker,
.calendar-modal-kicker {
    color: var(--green);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
}

.calendar-hero h1 {
    color: var(--green-dark);
}

.calendar-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.calendar-secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d7dfd4;
    background: white;
    color: var(--green-dark);
    border-radius: 12px;
    padding: 12px 18px;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
}

.calendar-layout {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 20px;
    direction: ltr;
}

.calendar-sidebar,
.calendar-main {
    direction: rtl;
}

.calendar-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.calendar-card {
    background: rgba(255,255,255,.92);
    border: 1px solid rgba(79,127,79,.13);
    border-radius: 22px;
    box-shadow: 0 10px 32px rgba(38,57,40,.07);
}

.calendar-sidebar .calendar-card {
    padding: 18px;
}

.calendar-card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--green-dark);
    font-weight: 800;
    margin-bottom: 14px;
}

.calendar-icon-button,
.calendar-close-button {
    border: 0;
    background: transparent;
    color: var(--muted);
    padding: 5px 9px;
    cursor: pointer;
    font-size: 20px;
}

.request-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 470px;
    overflow-y: auto;
}

.request-item {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: right;
    gap: 3px;
    width: 100%;
    border: 1px solid #e2e8df;
    background: #fbfcf9;
    color: var(--ink);
    border-radius: 14px;
    padding: 12px;
    cursor: pointer;
    transition: .18s ease;
}

.request-item:hover,
.request-item.selected {
    border-color: var(--green);
    background: var(--green-light);
}

.request-item-id {
    color: var(--green);
    font-size: 11px;
    font-family: monospace;
}

.request-item strong {
    font-size: 14px;
}

.request-item span:not(.request-item-id) {
    color: var(--muted);
    font-size: 12px;
}

.request-item small {
    color: #8a948b;
}

.request-item em {
    margin-top: 4px;
    color: var(--green-dark);
    font-size: 10px;
    font-style: normal;
}

.calendar-legend,
.calendar-rules {
    font-size: 12px;
}

.legend-row {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 10px 0;
    color: var(--muted);
}

.legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: 0 0 10px;
}

.legend-dot.scheduled {
    background: var(--green);
}

.legend-dot.buffer {
    background: #d2b878;
}

.legend-dot.available {
    background: #75a978;
}

.legend-dot.unavailable {
    background: #cfd5cf;
}

.rule-item {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #edf0eb;
}

.rule-item:last-child {
    border-bottom: 0;
}

.rule-item strong {
    color: var(--green-dark);
    white-space: nowrap;
}

.rule-item span {
    color: var(--muted);
    text-align: left;
}

.calendar-main {
    padding: 22px;
    min-width: 0;
}

.calendar-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.calendar-navigation {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
}

.calendar-nav-button,
.calendar-today-button {
    border: 1px solid #dce4d9;
    background: #fff;
    color: var(--green-dark);
    border-radius: 10px;
    min-width: 42px;
    height: 40px;
    cursor: pointer;
    font: inherit;
}

.calendar-nav-button {
    font-size: 23px;
    line-height: 1;
}

.calendar-today-button {
    padding: 0 14px;
    font-size: 13px;
}

.calendar-title {
    text-align: center;
    margin: 0;
    color: var(--green-dark);
    font-size: 22px;
}

.calendar-subtitle {
    text-align: center;
    margin-top: 3px;
    color: var(--muted);
    font-size: 11px;
}

.calendar-view-badge {
    justify-self: end;
    color: var(--muted);
    font-size: 11px;
    background: var(--cream-soft);
    padding: 8px 12px;
    border-radius: 20px;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid #e5ebe3;
    border-right: 1px solid #e5ebe3;
    overflow: hidden;
    border-radius: 14px;
}

.calendar-weekday {
    min-height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream-soft);
    color: var(--green-dark);
    font-size: 12px;
    font-weight: 800;
    border-left: 1px solid #e5ebe3;
    border-bottom: 1px solid #e5ebe3;
}

.calendar-day {
    min-height: 145px;
    padding: 9px;
    border: 0;
    border-left: 1px solid #e5ebe3;
    border-bottom: 1px solid #e5ebe3;
    background: white;
    text-align: right;
    cursor: pointer;
    transition: background .15s ease;
}

.calendar-day:hover {
    background: #f8fbf6;
}

.calendar-day.empty {
    background: #f7f8f5;
    cursor: default;
}

.calendar-day.today {
    box-shadow: inset 0 0 0 2px rgba(79,127,79,.45);
}

.calendar-day.selected-day {
    background: var(--green-light);
}

.calendar-day-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--green-dark);
    font-weight: 800;
    font-size: 13px;
}

.calendar-day.today .calendar-day-number {
    background: var(--green);
    color: white;
}

.calendar-day-events {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 7px;
}

.calendar-event {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 6px 7px;
    background: var(--green-light);
    border-right: 3px solid var(--green);
    border-radius: 7px;
    overflow: hidden;
}

.calendar-event b {
    color: var(--green-dark);
    font-size: 10px;
}

.calendar-event span {
    color: #536256;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.calendar-more {
    color: var(--muted);
    font-size: 10px;
    padding-right: 4px;
}

.calendar-loading,
.calendar-empty,
.slot-empty {
    padding: 20px;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
}

.calendar-loading-grid {
    grid-column: 1 / -1;
}

.calendar-load-error,
.calendar-modal-error {
    padding: 14px;
    background: #fff1f1;
    color: var(--danger);
    border-radius: 12px;
}

.day-panel {
    margin-top: 18px;
    padding: 18px;
    background: var(--cream-soft);
    border-radius: 16px;
}

.day-panel.hidden,
.calendar-modal.hidden {
    display: none;
}

.day-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 15px;
}

.day-panel-header h3 {
    margin: 0;
    color: var(--green-dark);
}

.day-panel-header p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.slot-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));
    gap: 9px;
}

.slot-button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    border: 1px solid #cbdac8;
    background: white;
    color: var(--green-dark);
    border-radius: 12px;
    padding: 11px;
    cursor: pointer;
    transition: .15s ease;
    font: inherit;
}

.slot-button:hover:not(:disabled) {
    border-color: var(--green);
    background: var(--green-light);
}

.slot-button strong {
    font-size: 15px;
}

.slot-button span {
    color: #759078;
    font-size: 10px;
}

.slot-button.unavailable {
    background: #eef0ed;
    color: #9aa19b;
    border-color: #e0e3df;
    cursor: not-allowed;
}

.slot-button.unavailable span {
    color: #a6ada7;
}

.calendar-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 20px;
}

.calendar-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28,43,32,.46);
    backdrop-filter: blur(3px);
}

.calendar-modal-card {
    position: relative;
    width: min(540px, 100%);
    background: white;
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 30px 90px rgba(22,37,26,.22);
}

.calendar-modal-header {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    align-items: flex-start;
    margin-bottom: 18px;
}

.calendar-modal-header h3 {
    margin: 0;
    color: var(--green-dark);
    font-size: 22px;
}

.modal-summary {
    background: var(--cream-soft);
    border-radius: 15px;
    padding: 14px;
}

.modal-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid #e7ebe5;
    font-size: 13px;
}

.modal-summary-row:last-of-type {
    border-bottom: 0;
}

.modal-summary-row span {
    color: var(--muted);
}

.modal-summary-row.highlight strong {
    color: var(--green-dark);
}

.modal-summary-rule {
    margin-top: 10px;
    color: var(--muted);
    font-size: 11px;
}

.modal-form-group {
    margin-top: 16px;
}

.modal-form-group label {
    display: block;
    margin-bottom: 7px;
    color: var(--green-dark);
    font-weight: 700;
    font-size: 12px;
}

.modal-form-group textarea {
    width: 100%;
    resize: vertical;
    border: 1px solid #d8e0d5;
    background: #fbfcfa;
    border-radius: 12px;
    padding: 11px;
    font: inherit;
}

.modal-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.modal-confirm-button {
    border: 0;
}

.calendar-modal-error {
    margin-top: 14px;
}

@media (max-width: 1000px) {
    .calendar-layout {
        grid-template-columns: 1fr;
    }

    .request-list {
        max-height: 280px;
    }
}

@media (max-width: 700px) {
    .calendar-main {
        padding: 12px;
    }

    .calendar-toolbar {
        grid-template-columns: 1fr;
    }

    .calendar-navigation,
    .calendar-view-badge {
        justify-self: center;
    }

    .calendar-day {
        min-height: 100px;
        padding: 5px;
    }

    .calendar-event span {
        display: none;
    }

    .calendar-event {
        padding: 5px;
    }

    .calendar-weekday {
        font-size: 9px;
    }

    .calendar-day-number {
        min-width: 26px;
        height: 26px;
    }

    .slot-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

/* =========================================================
   GV CALENDAR JALALI + DASHBOARD QUICK CALENDAR
   ========================================================= */

.gv-dashboard-calendar-card {
    margin-top: 24px;
    background: var(--white);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 8px 28px rgba(38,57,40,.08);
}

.gv-dashboard-calendar-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
}

.gv-dashboard-calendar-head h2 {
    margin: 0 0 6px;
}

.gv-dashboard-calendar-head p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
}

.gv-dashboard-calendar-toolbar {
    display: grid;
    grid-template-columns: 42px 1fr 42px;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
}

.gv-dashboard-calendar-toolbar button {
    width: 42px;
    height: 42px;
    padding: 0;
}

.gv-dashboard-calendar-toolbar strong {
    text-align: center;
    font-size: 18px;
    color: var(--green-dark);
}

.gv-dashboard-weekdays,
.gv-dashboard-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 7px;
}

.gv-dashboard-weekdays {
    margin-bottom: 7px;
}

.gv-dashboard-weekdays span {
    text-align: center;
    color: var(--muted);
    font-size: 12px;
    font-weight: bold;
    padding: 7px;
}

.gv-dashboard-calendar-day,
.gv-dashboard-calendar-empty {
    min-height: 46px;
    border-radius: 10px;
}

.gv-dashboard-calendar-day {
    display: grid;
    place-items: center;
    text-decoration: none;
    background: var(--cream-soft);
    color: var(--ink);
    border: 1px solid #e4e9df;
    transition: .15s ease;
}

.gv-dashboard-calendar-day:hover {
    border-color: var(--green);
    transform: translateY(-1px);
}

.gv-dashboard-calendar-day.is-today {
    background: var(--green-light);
    color: var(--green-dark);
    font-weight: bold;
    border-color: var(--green);
}

.gv-request-list {
    display: grid;
    gap: 10px;
}

.gv-request-item {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    background: var(--cream-soft);
    color: var(--ink);
    border: 1px solid #e2e8df;
    text-align: right;
}

.gv-request-item:hover,
.gv-request-item.is-selected {
    border-color: var(--green);
    background: var(--green-light);
}

.gv-request-item span,
.gv-request-item small {
    color: var(--muted);
}

.gv-calendar-request-panel {
    margin-bottom: 20px;
}

.gv-event-actions {
    margin-top: 10px;
}

.gv-danger-btn {
    background: #fff0f0;
    color: var(--danger);
    border: 1px solid #f0caca;
}

@media (max-width: 700px) {
    .gv-dashboard-calendar-head {
        flex-direction: column;
        align-items: stretch;
    }

    .gv-dashboard-calendar-head .primary-link {
        text-align: center;
    }
}

/* =========================================================
   GV SMART BIO ANALYTICS
   ========================================================= */

.smart-bio-analytics {
    margin-top: 28px;
    padding: 24px;
    background: rgba(255, 255, 255, .86);
    border: 1px solid rgba(47, 107, 63, .12);
    border-radius: 24px;
    box-shadow: 0 12px 35px rgba(35, 79, 47, .08);
}

.smart-bio-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
}

.smart-bio-head h2 {
    margin: 0;
    color: #234f2f;
    font-size: 20px;
}

.smart-bio-head p {
    margin: 6px 0 0;
    color: #718074;
    font-size: 12px;
}

.smart-bio-total {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    margin-bottom: 14px;
    border-radius: 18px;
    background: #eaf3ec;
}

.smart-bio-total span {
    color: #718074;
    font-size: 13px;
    font-weight: 700;
}

.smart-bio-total strong {
    color: #234f2f;
    font-size: 30px;
}

.smart-bio-channels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.smart-bio-channel {
    display: grid;
    grid-template-columns: 42px 1fr auto;
    align-items: center;
    gap: 10px;
    min-height: 72px;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid rgba(47, 107, 63, .10);
    border-radius: 16px;
}

.smart-bio-channel-icon {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #eaf3ec;
    font-size: 18px;
}

.smart-bio-channel div {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.smart-bio-channel strong {
    color: #26352a;
    font-size: 13px;
}

.smart-bio-channel small {
    margin-top: 3px;
    color: #718074;
    font-size: 9px;
    direction: ltr;
    text-align: right;
}

.smart-bio-channel b {
    color: #2f6b3f;
    font-size: 21px;
}

.smart-bio-recent {
    margin-top: 22px;
}

.smart-bio-recent h3 {
    margin: 0 0 12px;
    color: #234f2f;
    font-size: 15px;
}

.smart-bio-recent-list {
    overflow: hidden;
    border: 1px solid rgba(47, 107, 63, .10);
    border-radius: 16px;
    background: #fff;
}

.smart-bio-recent-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(47, 107, 63, .07);
    font-size: 11px;
}

.smart-bio-recent-row:last-child {
    border-bottom: 0;
}

.smart-bio-recent-channel {
    color: #26352a;
    font-weight: 800;
}

.smart-bio-recent-path {
    direction: ltr;
    text-align: right;
    color: #718074;
}

.smart-bio-recent-row time {
    direction: ltr;
    text-align: left;
    color: #718074;
    font-size: 10px;
}

.smart-bio-empty {
    margin-top: 18px;
    padding: 18px;
    border-radius: 16px;
    background: #f7f1e3;
    color: #718074;
    text-align: center;
    font-size: 12px;
}

@media (max-width: 900px) {
    .smart-bio-channels {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .smart-bio-analytics {
        padding: 17px;
        border-radius: 20px;
    }

    .smart-bio-head {
        align-items: flex-start;
        flex-direction: column;
    }

    .smart-bio-head .primary-link {
        width: 100%;
        text-align: center;
    }

    .smart-bio-channels {
        grid-template-columns: 1fr;
    }

    .smart-bio-recent-row {
        grid-template-columns: 1fr 1fr;
    }

    .smart-bio-recent-path {
        display: none;
    }

    .smart-bio-recent-row time {
        text-align: left;
    }
}


/* =========================================================
   GV SMART BIO PHASE 7 — PERIOD ANALYTICS
   ========================================================= */

.smart-bio-periods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
}

.smart-bio-period {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid rgba(47, 107, 63, .10);
    border-radius: 16px;
}

.smart-bio-period span {
    color: #718074;
    font-size: 12px;
    font-weight: 700;
}

.smart-bio-period strong {
    color: #2f6b3f;
    font-size: 22px;
}

@media (max-width: 600px) {
    .smart-bio-periods {
        grid-template-columns: 1fr;
    }
}


/* =========================================================
   GV SMART BIO PHASE 8 — VISUAL ANALYTICS
   ========================================================= */

.smart-bio-top-channel {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 14px;

    margin: 0 0 16px;
    padding: 14px 16px;

    background: linear-gradient(
        135deg,
        rgba(47, 107, 63, .09),
        rgba(255, 255, 255, .95)
    );

    border: 1px solid rgba(47, 107, 63, .12);
    border-radius: 16px;
}

.smart-bio-top-channel > span {
    color: #718074;
    font-size: 12px;
    font-weight: 700;
}

.smart-bio-top-channel > strong {
    color: #234f2f;
    font-size: 15px;
    font-weight: 800;
}

.smart-bio-top-channel > small {
    color: #718074;
    font-size: 11px;
    font-weight: 700;
}

.smart-bio-channel-stats {
    margin-bottom: 18px;
    padding: 16px;

    background: rgba(255, 255, 255, .72);

    border: 1px solid rgba(47, 107, 63, .09);
    border-radius: 18px;
}

.smart-bio-channel-stats h3 {
    margin: 0 0 16px;

    color: #26352a;

    font-size: 14px;
    font-weight: 800;
}

.smart-bio-channel-stat {
    margin-bottom: 15px;
}

.smart-bio-channel-stat:last-child {
    margin-bottom: 0;
}

.smart-bio-channel-stat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 7px;

    color: #26352a;
    font-size: 12px;
    font-weight: 700;
}

.smart-bio-channel-stat-head strong {
    color: #2f6b3f;
    font-size: 13px;
}

.smart-bio-channel-stat-head strong small {
    color: #718074;
    font-size: 10px;
    font-weight: 700;
}

.smart-bio-progress {
    width: 100%;
    height: 8px;

    overflow: hidden;

    background: #e8eee9;

    border-radius: 999px;
}

.smart-bio-progress span {
    display: block;

    height: 100%;

    min-width: 2px;

    background: #2f6b3f;

    border-radius: inherit;

    transition: width .35s ease;
}

@media (max-width: 600px) {

    .smart-bio-top-channel {
        grid-template-columns: 1fr auto;
        gap: 7px 12px;
    }

    .smart-bio-top-channel > small {
        grid-column: 1 / -1;
    }

    .smart-bio-channel-stats {
        padding: 14px;
        border-radius: 16px;
    }
}
